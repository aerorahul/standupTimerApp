{
  "name": "standup-timer-app",
  "version": "1.0.0",
  "description": "A customizable timer application for managing standup meetings",
  "main": "script.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:simple": "node ../tests/runners/test-simple.js"
  },
  "keywords": [
    "timer",
    "standup",
    "scrum",
    "meeting"
  ],
  "author": "Rahul Mahajan",
  "license": "CC0",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "rootDir": "..",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/utils/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/unit/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/script.js",
      "!node_modules/**"
    ],
    "moduleDirectories": [
      "node_modules",
      "config/node_modules"
    ]
  }
}
